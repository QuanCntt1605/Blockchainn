# WARRANTY CERTIFICATE BACKEND - Environment Variables

# RPC Endpoint (dùng Sepolia testnet)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Hoặc dùng local Hardhat node: http://localhost:8545

# Smart Contract Address (sau khi deploy)
CONTRACT_ADDRESS=0x...

# Admin Private Key (KHÔNG share!)
# Tạo từ MetaMask > Account Details > Export Private Key
ADMIN_PRIVATE_KEY=0x...

# Server Port
PORT=3000

# JWT Secret (dùng để tạo token)
JWT_SECRET=your-secret-key-change-this-in-production
